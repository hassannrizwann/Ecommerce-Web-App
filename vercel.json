{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__northstar_path=/api/:path*" },
    { "source": "/healthz", "destination": "/api/index?__northstar_path=/healthz" },
    { "source": "/media/:path*", "destination": "/api/index?__northstar_path=/media/:path*" },
    { "source": "/robots.txt", "destination": "/api/index?__northstar_path=/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/index?__northstar_path=/sitemap.xml" }
  ]
}
